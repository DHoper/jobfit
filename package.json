{
  "name": "jobfit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "package": "wxt build && mkdir -p dist && rm -f dist/jobfit-extension.zip && cd .output/chrome-mv3 && zip -qr ../../dist/jobfit-extension.zip ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
